{
  "name": "motion-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:overlay": "tsx --tsconfig tsconfig.app.json scripts/lint-overlay.ts",
    "sync:cards": "node scripts/sync-skill-cards.mjs && node scripts/sync-agent-skills.mjs",
    "check:cards": "node scripts/check-card-defaults.mjs && node scripts/check-motion.mjs && node scripts/check-vtier.mjs && node scripts/sync-skill-cards.mjs --check && node scripts/sync-agent-skills.mjs --check",
    "check:defaults": "node scripts/check-card-defaults.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:vtier": "node scripts/check-vtier.mjs",
    "sync:agent-skills": "node scripts/sync-agent-skills.mjs",
    "check:agent-skills": "node scripts/sync-agent-skills.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "puppeteer": "^25.3.0",
    "simple-icons": "^16.27.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
